@page "{id:int}"
@model MinorProject3.Web.Pages.EditItemModel
@{
    ViewData["Title"] = "Edit Item";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card">
                <div class="card-header bg-dark text-white">
                    <h5 class="mb-0">Edit Inventory Item</h5>
                </div>
                <div class="card-body">
                    <form method="post">
                        <input type="hidden" asp-for="Item.Id" />

                        <div class="mb-3">
                            <label asp-for="Item.ItemName" class="form-label">Item Name</label>
                            <input asp-for="Item.ItemName" class="form-control" required />
                            <span asp-validation-for="Item.ItemName" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Item.ItemType" class="form-label">Item Type</label>
                            <select asp-for="Item.ItemType" class="form-select" required>
                                <option value="Weapon">Weapon</option>
                                <option value="Armor">Armor</option>
                                <option value="Consumable">Consumable</option>
                                <option value="Jewelry">Jewelry</option>
                                <option value="Material">Material</option>
                            </select>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Item.Rarity" class="form-label">Rarity</label>
                            <select asp-for="Item.Rarity" class="form-select">
                                <option value="Common">Common</option>
                                <option value="Uncommon">Uncommon</option>
                                <option value="Rare">Rare</option>
                                <option value="Epic">Epic</option>
                                <option value="Legendary">Legendary</option>
                                <option value="Purchased">Purchased</option>
                            </select>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Item.ValueGold" class="form-label">Value (Gold)</label>
                            <input asp-for="Item.ValueGold" type="number" class="form-control" required />
                            <span asp-validation-for="Item.ValueGold" class="text-danger"></span>
                        </div>

                        <div class="d-flex justify-content-between">
                            <a asp-page="/SearchItems" class="btn btn-outline-secondary px-4">Cancel</a>
                            <button type="submit" class="btn btn-dark px-4">Update Item</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>