@page
@model MinorProject3.Web.Pages.SearchItems
@{
    ViewData["Title"] = "Item Search & Inventory";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Inventory & Item Search</h2>
        <span>Results Found: @Model.Items.Count</span>
    </div>

    <div class="card mb-4">
        <div class="card-body">
            <form method="get" class="row g-3">
                <div class="col-md-2">
                    <label asp-for="SearchId" class="form-label">Item ID</label>
                    <input asp-for="SearchId" type="number" class="form-control" placeholder="ID" />
                </div>
                <div class="col-md-5">
                    <label asp-for="SearchTerm" class="form-label">Search Item Name or Rarity</label>
                    <input asp-for="SearchTerm" class="form-control" placeholder="e.g. Sword, Legendary, Potion..." />
                </div>
                <div class="col-md-3">
                    <label asp-for="ItemTypeFilter" class="form-label">Filter by Item Type</label>
                    <select asp-for="ItemTypeFilter" class="form-select">
                        <option value="">All Types</option>
                        <option value="Weapon">Weapon</option>
                        <option value="Armor">Armor</option>
                        <option value="Consumable">Consumable</option>
                        <option value="Material">Material</option>
                        <option value="Jewelry">Jewelry</option>
                    </select>
                </div>
                <div class="col-md-2 d-flex align-items-end">
                    <button type="submit" class="w-100 btn btn-dark">Search</button>
                </div>
            </form>
        </div>
    </div>

    <div class="card mb-5">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table mb-0 align-middle">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Item Name</th>
                            <th>Type</th>
                            <th>Rarity</th>
                            <th>Value (Gold)</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Items.Any())
                        {
                            @foreach (var item in Model.Items)
                            {
                                <tr>
                                    <td>@item.Id</td>
                                    <td>@item.ItemName</td>
                                    <td>@item.ItemType</td>
                                    <td>@item.Rarity</td>
                                    <td>@item.ValueGold</td>
                                    <td>
                                        <a asp-page="/EditItem" asp-route-id="@item.Id" class="btn btn-sm btn-outline-dark me-1">Edit</a>
                                        <form method="post" asp-page-handler="Delete" asp-route-id="@item.Id" onsubmit="return confirm('Are you sure you want to discard this item?');" class="d-inline">
                                            <input type="hidden" name="SearchId" value="@Model.SearchId" />
                                            <input type="hidden" name="SearchTerm" value="@Model.SearchTerm" />
                                            <input type="hidden" name="ItemTypeFilter" value="@Model.ItemTypeFilter" />
                                            <button type="submit" class="btn btn-sm btn-outline-secondary">Delete</button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="text-center py-4">No items matched your search criteria.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="card">
        <div class="card-header">
            <h5 class="mb-0">Forge New Item</h5>
        </div>
        <div class="card-body">
            <form method="post" asp-page-handler="Add">
                <div class="row g-3">
                    <div class="col-md-4">
                        <label asp-for="NewItem.ItemName" class="form-label">Item Name</label>
                        <input asp-for="NewItem.ItemName" class="form-control" placeholder="e.g. Dragonbone Sword" required />
                    </div>
                    <div class="col-md-3">
                        <label asp-for="NewItem.ItemType" class="form-label">Item Type</label>
                        <select asp-for="NewItem.ItemType" class="form-select" required>
                            <option value="">Select Type</option>
                            <option value="Weapon">Weapon</option>
                            <option value="Armor">Armor</option>
                            <option value="Consumable">Consumable</option>
                            <option value="Material">Material</option>
                            <option value="Jewelry">Jewelry</option>
                        </select>
                    </div>
                    <div class="col-md-2">
                        <label asp-for="NewItem.Rarity" class="form-label">Rarity</label>
                        <select asp-for="NewItem.Rarity" class="form-select">
                            <option value="Common">Common</option>
                            <option value="Uncommon">Uncommon</option>
                            <option value="Rare">Rare</option>
                            <option value="Epic">Epic</option>
                            <option value="Legendary">Legendary</option>
                        </select>
                    </div>
                    <div class="col-md-2">
                        <label asp-for="NewItem.ValueGold" class="form-label">Value (Gold)</label>
                        <input asp-for="NewItem.ValueGold" type="number" class="form-control" value="100" required />
                    </div>
                    <div class="col-md-1 d-flex align-items-end">
                        <button type="submit" class="btn btn-dark w-100">Forge</button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>