@page "{id:int}"
@model MinorProject3.Web.Pages.EditAdminSettingModel
@{
    ViewData["Title"] = "Edit Admin Setting";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card">
                <div class="card-header bg-dark text-white">
                    <h5 class="mb-0">Edit Admin Setting</h5>
                </div>
                <div class="card-body">
                    <form method="post">
                        <input type="hidden" asp-for="Setting.Id" />

                        <div class="mb-3">
                            <label asp-for="Setting.SettingKey" class="form-label">Setting Key</label>
                            <input asp-for="Setting.SettingKey" class="form-control" required />
                            <span asp-validation-for="Setting.SettingKey" class="text-danger"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Setting.SettingValue" class="form-label">Setting Value</label>
                            <input asp-for="Setting.SettingValue" class="form-control" required />
                            <span asp-validation-for="Setting.SettingValue" class="text-danger"></span>
                        </div>

                        <div class="d-flex justify-content-between">
                            <a asp-page="/AdminSettings" class="btn btn-outline-secondary px-4">Cancel</a>
                            <button type="submit" class="btn btn-dark px-4">Update Setting</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>